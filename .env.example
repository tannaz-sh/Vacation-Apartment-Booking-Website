# Never enable fixtures on a public deployment.
DEVELOPMENT_FIXTURES=false
SITE_INDEXABLE=false
SITE_URL=http://127.0.0.1:3000
# Optional override of the non-secret, account-provided Smoobu embed endpoint.
SMOOBU_EMBED_URL=https://login.smoobu.com/de/booking-tool/iframe/1947006
# Configure through your hosting secret store; never commit actual values.
DATABASE_URL=
PAYLOAD_SECRET=
# First administrator only: supply temporarily, run cms:bootstrap, then remove.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
