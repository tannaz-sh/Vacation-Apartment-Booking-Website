{
  "name": "rf-sauerland-immobilien",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/domain.test.ts tests/support.test.ts",
    "test:e2e": "playwright test",
    "cms:types": "payload generate:types",
    "cms:migrate": "payload migrate",
    "cms:bootstrap": "payload run scripts/bootstrap-admin.ts",
    "test:cms": "payload run tests/cms.integration.ts",
    "test:cms:ui": "payload run tests/cms-ui.run.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.94.1",
    "@payloadcms/next": "3.94.1",
    "@payloadcms/translations": "3.94.1",
    "graphql": "16.11.0",
    "next": "16.4.6",
    "payload": "3.94.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "type": "module"
}
