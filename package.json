    "cms:importmap": "node --env-file=.env.local node_modules/payload/bin.js generate:importmap",
    "cms:seed": "node --env-file=.env.local node_modules/tsx/dist/cli.mjs scripts/seed-cms.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.94.0",
    "@payloadcms/next": "3.94.0",
    "graphql": "16.15.0",
    "next": "16.4.6",
    "payload": "3.94.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.6",
    "pg": "8.23.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "type": "module"
}
